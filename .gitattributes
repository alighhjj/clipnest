# 仓库内统一存 LF，避免 Windows 上 autocrlf 把 CRLF 提交进去
# （CI 在 Linux/macOS 上跑，工作流文件与 Rust 源码混入 CRLF 容易出怪问题）
* text=auto

# 二进制资源不得做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.gif binary
*.woff binary
*.woff2 binary

# 明确按文本处理
*.rs   text
*.toml text
*.ts   text
*.tsx  text
*.json text
*.yml  text
*.yaml text
*.md   text
*.css  text
*.html text
*.py   text
